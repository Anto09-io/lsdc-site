# ── Variables d'environnement La Science du Cyclisme ──
# Copie ce fichier en .env.local et renseigne tes valeurs.
# NE JAMAIS commiter .env.local ni de vraie clé API.

# ── Beehiiv (route /api/subscribe — quiz, calculateurs, newsletter) ──
# Clé API Beehiiv (Settings > API dans Beehiiv).
BEEHIIV_API_KEY=
# ID de la publication Beehiiv (pub_xxx).
BEEHIIV_PUB_ID=
# ID d'automation par défaut (fallback si un ID dédié n'est pas renseigné).
BEEHIIV_AUTOMATION_ID=
# ID d'automation dédiée au quiz /quiz (optionnel, sinon fallback sur BEEHIIV_AUTOMATION_ID).
BEEHIIV_AUTOMATION_QUIZ_ID=
# ID d'automation dédiée à l'opt-in newsletter /articles (optionnel).
BEEHIIV_AUTOMATION_NEWSLETTER_ID=
# ID d'automation dédiée à la liste d'attente JustPush (optionnel).
BEEHIIV_AUTOMATION_WAITINGLIST_ID=

# URL absolue du site en production (sans slash final), utilisée pour le SEO,
# le sitemap, les URLs canoniques et le flux RSS.
NEXT_PUBLIC_SITE_URL=https://lascienceducyclisme.com

# ── Import des articles Beehiiv (script npm run import:beehiiv) ──
# Sert uniquement en local pour l'import ponctuel : pas besoin dans Vercel.
# Optionnel : ID de la publication (pub_xxx). Laissé vide, le script la détecte
# (peut être la même valeur que BEEHIIV_PUB_ID ci-dessus).
BEEHIIV_PUBLICATION_ID=
